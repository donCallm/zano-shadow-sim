+    pc.pos_starter_difficulty = wide_difficulty_type(DIFFICULTY_POS_STARTER);
     pc.pre_hardfork_tx_freeze_period = CURRENCY_PRE_HARDFORK_TX_FREEZE_PERIOD;
     
