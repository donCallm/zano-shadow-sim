+  {
+    currency::account_public_address addr = AUTO_VAL_INIT(addr);
+    if (!currency::get_account_address_from_str(addr, req.wallet_address))
+    {
+      error_resp.code = CORE_RPC_ERROR_CODE_WRONG_PARAM;
+      error_resp.message = "Failed to parse wallet_address: " + req.wallet_address;
+      return false;
+    }
+
+    for (uint64_t i = 0; i < req.amount_of_blocks; ++i)
+    {
+      currency::create_block_template_params  p = AUTO_VAL_INIT(p);
+      currency::create_block_template_response r = AUTO_VAL_INIT(r);
+      p.miner_address        = addr;
+      p.stakeholder_address  = addr;
+      p.pos                  = false;
+      p.ignore_pow_ts_check  = true;
+
+      if (!m_core.get_block_template(p, r))
+      {
+        error_resp.code = CORE_RPC_ERROR_CODE_INTERNAL_ERROR;
+        error_resp.message = "get_block_template failed at iteration " + std::to_string(i);
+        return false;
+      }
+
+      if (!currency::find_nonce_for_given_block(r.b, r.diffic, r.height))
+      {
+        error_resp.code = CORE_RPC_ERROR_CODE_INTERNAL_ERROR;
+        error_resp.message = "find_nonce_for_given_block failed at height " + std::to_string(r.height);
+        return false;
+      }
+
+      currency::block_verification_context bvc = AUTO_VAL_INIT(bvc);
+      m_core.handle_incoming_block(r.b, bvc);
+      if (bvc.m_verification_failed || !bvc.m_added_to_main_chain)
+      {
+        error_resp.code = CORE_RPC_ERROR_CODE_INTERNAL_ERROR;
+        error_resp.message = "block rejected at height " + std::to_string(r.height) +
+                             " (failed=" + std::to_string(bvc.m_verification_failed) +
+                             ", added=" + std::to_string(bvc.m_added_to_main_chain) + ")";
+        return false;
+      }
+    }
+
+    res.height = m_core.get_current_blockchain_size() - 1;
+    res.status = API_RETURN_CODE_OK;
+    return true;
+  }
