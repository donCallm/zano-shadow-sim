     CHECK_AND_ASSERT_THROW_MES(r, "failed to parse alias_validation_pub_key");
+#ifdef ZANO_SIMNET
+    if (get_simnet_runtime_overrides().hard_forks_set)
+      pc.hard_forks = get_simnet_runtime_overrides().hard_forks;
+#endif
     return pc;
