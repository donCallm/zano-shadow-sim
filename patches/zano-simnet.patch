@@ -113,6 +113,7 @@ namespace currency
     core_time_func_t get_core_time;
     uint64_t hf4_minimum_mixins;
     wide_difficulty_type max_pos_difficulty;
+    wide_difficulty_type pos_starter_difficulty; // seeds the PoS retarget; equilibrium scales with total stake, so a header constant only fits one stand
     uint64_t pre_hardfork_tx_freeze_period; // number of blocks before the hardfork activatio when no new txs are accepted (effective from HF5); 0 means feature is switched off
 
     hard_forks_descriptor hard_forks;
@@ -134,6 +135,50 @@ namespace currency
     }
   };
 
+#ifdef ZANO_SIMNET
+  // Simnet: process-wide overrides, set from the command line BEFORE the core or any
+  // wallet2 is constructed. get_default_core_runtime_config() applies them, so every
+  // construction site in both binaries (5 in simplewallet alone) picks them up without
+  // per-site plumbing. The wallet never receives the schedule from the daemon at
+  // runtime -- wallet2::set_core_runtime_config is called by tests only -- and the RPC
+  // exposes active flags, not heights, so a shared default is the only single point.
+  struct simnet_runtime_overrides
+  {
+    bool hard_forks_set = false;
+    hard_forks_descriptor hard_forks;
+  };
+  inline simnet_runtime_overrides& get_simnet_runtime_overrides()
+  {
+    static simnet_runtime_overrides overrides{};
+    return overrides;
+  }
+  // Parses repeatable "<id>:<height>" specs (--hard-fork). Mind set_hardfork_height:
+  // it back-fills all UNSET previous forks to the same height. Convenient for
+  // "--hard-fork=4:10" (forks 1-3 also land on 10), but a lagging-node schedule like
+  // "6:999999" must list the earlier forks explicitly FIRST, or they all move away.
+  inline bool simnet_set_hardfork_overrides(const std::vector<std::string>& specs, std::string& err)
+  {
+    hard_forks_descriptor hfd{};
+    for (const auto& s : specs)
+    {
+      const auto colon = s.find(':');
+      uint64_t id = 0, h = 0;
+      if (colon == std::string::npos
+        || !epee::string_tools::get_xtype_from_string(id, s.substr(0, colon))
+        || !epee::string_tools::get_xtype_from_string(h, s.substr(colon + 1))
+        || id == 0 || id >= ZANO_HARDFORKS_TOTAL)
+      {
+        err = std::string("bad --hard-fork spec '") + s + "', expected <id>:<height> with 0 < id < " + std::to_string(ZANO_HARDFORKS_TOTAL);
+        return false;
+      }
+      hfd.set_hardfork_height(id, h);
+    }
+    get_simnet_runtime_overrides().hard_forks = hfd;
+    get_simnet_runtime_overrides().hard_forks_set = true;
+    return true;
+  }
+#endif
+
   inline core_runtime_config get_default_core_runtime_config()
   {
     core_runtime_config pc{};
